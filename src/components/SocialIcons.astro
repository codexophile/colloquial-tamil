---
// src/components/SocialIcons.astro
import Default from '@astrojs/starlight/components/SocialIcons.astro'
import GoodReadsIcon from '../assets/goodreads.svg?raw'  // ?raw gives you the SVG string
// OR as a component if using @astrojs/svg or similar:
// import MyIcon from '../icons/my-icon.svg'
---

<a href="https://www.goodreads.com/book/show/183958.Colloquial_Tamil" rel="me" class="sl-flex">
  <span class="sr-only">View on Goodreads</span>
  <!-- paste via Fragment to avoid wrapping element -->
  <Fragment set:html={GoodReadsIcon} />
</a>

<!-- Keeps ALL your configured default social icons -->
<Default {...Astro.props}><slot /></Default>

<style>
  a {
    color: var(--sl-color-text-accent);
    margin: -0.5em;
    padding: 0.5em;
  }
  a:hover {
    opacity: 0.66;
  }
  /* Make sure your SVG matches the default 16×16 size */
  a :global(svg) {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }
</style>