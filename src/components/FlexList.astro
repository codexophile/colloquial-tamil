---
// FlexList.astro
---

<div class="flex-list">
  <slot />
</div>

<style>
  .flex-list :global(ul) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;

    list-style: none;
    padding: 0;
    margin: 0;
  }

  .flex-list :global(li) {
    display: flex;
    align-items: center;
    justify-content: center;

    /* min-width: 140px; */
    padding: 0.9rem 1.2rem;

    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,0.04),
        rgba(255,255,255,0.02)
      );

    backdrop-filter: blur(8px);

    font-weight: 500;
    line-height: 1.4;

    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .flex-list :global(li:hover) {
    transform: translateY(-2px);

    border-color: var(--sl-color-accent);

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,0.07),
        rgba(255,255,255,0.03)
      );
  }

  .flex-list :global(li p) {
    margin: 0;
  }

  .flex-list :global(a) {
    text-decoration: none;
  }
</style>