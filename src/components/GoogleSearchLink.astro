---
interface Props {
  query: string;
  label?: string;
  class?: string;
  newTab?: boolean;
}

const {
  query,
  label = `Search Google for \"${query}\"`,
  class: className = "",
  newTab = true,
} = Astro.props;

const googleSearchUrl = `https://www.google.com/search?q=${encodeURIComponent(query)}`;
---

<a
  href={googleSearchUrl}
  class={`google-search-link ${className}`}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  aria-label={`Search Google for ${query}`}
>
  <span class="content">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>

    <span class="text">{label}</span>
  </span>

  <span class="arrow">↗</span>
</a>

<style>
  .google-search-link {
    --bg: rgba(255, 255, 255, 0.08);
    --border: rgba(255, 255, 255, 0.12);
    --text: rgb(245, 245, 245);
    --muted: rgba(255, 255, 255, 0.7);
    --hover: rgba(255, 255, 255, 0.14);

    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    min-width: 240px;
    max-width: 100%;

    padding: 0.9rem 1rem;
    border-radius: 1.25rem;

    background: var(--bg);
    border: 1px solid var(--border);
    backdrop-filter: blur(14px);

    color: var(--text);
    text-decoration: none;

    transition:
      transform 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .google-search-link:hover {
    transform: translateY(-2px);
    background: var(--hover);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .google-search-link:active {
    transform: translateY(0);
  }

  .google-search-link:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 3px;
  }

  .content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--muted);
  }

  .text {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;

    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .arrow {
    font-size: 1rem;
    color: var(--muted);
    transition: transform 180ms ease;
    flex-shrink: 0;
  }

  .google-search-link:hover .arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .google-search-link {
      width: 100%;
    }
  }
</style>
