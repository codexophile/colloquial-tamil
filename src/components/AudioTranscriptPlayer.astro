---
interface TranscriptSegment {
  start: number;
  end?: number;
  speaker?: string;
  text: string;
}

interface Props {
  src: string;
  title?: string;
  artist?: string;
  poster?: string;
  transcript?: TranscriptSegment[] | string;
  accent?: string;
  autoplay?: boolean;
}

const {
  src,
  title = 'Audio Track',
  artist = 'Unknown Artist',
  poster,
  transcript = [],
  accent = '#8b5cf6',
  autoplay = false
} = Astro.props;

const transcriptSource = typeof transcript === 'string' ? transcript : '';
const transcriptSegments = Array.isArray(transcript) ? transcript : [];
const hasTranscript = transcriptSegments.length > 0 || Boolean(transcriptSource);

const componentId = `audio-player-${Math.random().toString(36).slice(2)}`;
---

<div
  class="audio-player"
  id={componentId}
  style={`--accent:${accent};`}
>
  <div class="player-shell">
    <div class="player-top">
      {
        poster ? (
          <img
            class="poster"
            src={poster}
            alt={title}
            loading="lazy"
          />
        ) : (
          <div class="poster placeholder">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 19V6l12-2v13"
              />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="16" r="3" />
            </svg>
          </div>
        )
      }

      <div class="meta">
        <div class="eyebrow">Transcript Player</div>
        <h3>{title}</h3>
        <p>{artist}</p>
      </div>
    </div>

    <audio
      class="native-audio"
      controls
      preload="metadata"
      src={src}
      autoplay={autoplay}
    />

    {
      hasTranscript && (
        <div class="transcript-wrapper">
          <div class="transcript-header">
            <span>Transcript</span>
            <button
              type="button"
              class="follow-button"
              data-follow-toggle
            >
              Auto Follow: On
            </button>
          </div>

          <div
            class="transcript"
            data-transcript
            data-transcript-source={transcriptSource}
          >
            {
              transcriptSegments.length > 0 ? (
                transcriptSegments.map((segment, index) => (
                  <button
                    type="button"
                    class="segment"
                    data-segment
                    data-index={index}
                    data-start={segment.start}
                    data-end={segment.end ?? ''}
                  >
                    <span class="time">
                      {new Date(segment.start * 1000)
                        .toISOString()
                        .slice(14, 19)}
                    </span>

                    <span class="content">
                      {segment.speaker && (
                        <span class="speaker">{segment.speaker}</span>
                      )}

                      <span class="text">{segment.text}</span>
                    </span>
                  </button>
                ))
              ) : (
                <p class="transcript-status" data-transcript-status>
                  Loading transcript from VTT...
                </p>
              )
            }
          </div>
        </div>
      )
    }
  </div>
</div>

<script define:vars={{ componentId, transcriptSource }}>
  const root = document.getElementById(componentId);

  if (root) {
    const audio = root.querySelector('audio');
    const transcript = root.querySelector('[data-transcript]');
    const followButton = root.querySelector('[data-follow-toggle]');

    let autoFollow = true;
    let activeIndex = -1;

    const getSegments = () => [...root.querySelectorAll('[data-segment]')];

    const formatTime = (seconds) =>
      new Date(seconds * 1000).toISOString().slice(14, 19);

    const parseTimestamp = (value) => {
      const trimmed = value.trim();
      const [timePart, fractionPart = '0'] = trimmed.split('.');
      const parts = timePart.split(':').map(Number);
      const fraction = Number(`0.${fractionPart}`);

      if (parts.length === 3) {
        return parts[0] * 3600 + parts[1] * 60 + parts[2] + fraction;
      }

      if (parts.length === 2) {
        return parts[0] * 60 + parts[1] + fraction;
      }

      return Number(trimmed) || 0;
    };

    const parseCueText = (input) => {
      const voiceTagPattern = /^<v(?:\s+([^>]+))?>/i;
      const lines = input
        .replace(/<v(?:\s+([^>]+))?>/gi, '')
        .replace(/<\/v>/gi, '')
        .split(/\r?\n/)
        .map((line) => line.trim())
        .filter(Boolean);

      const speakerMatch = input.trim().match(voiceTagPattern);
      const speaker = speakerMatch?.[1]?.trim() || '';

      return {
        speaker,
        text: lines.join(' ').trim()
      };
    };

    const parseWebVtt = (input) => {
      const lines = input.replace(/^\uFEFF/, '').split(/\r?\n/);
      const segments = [];
      let index = 0;

      if (lines[index]?.trim().startsWith('WEBVTT')) {
        index += 1;
      }

      while (index < lines.length) {
        while (index < lines.length && !lines[index].trim()) {
          index += 1;
        }

        if (index >= lines.length) {
          break;
        }

        let timeLine = lines[index].trim();

        if (!timeLine.includes('-->')) {
          index += 1;
          timeLine = lines[index]?.trim() || '';
        }

        if (!timeLine.includes('-->')) {
          index += 1;
          continue;
        }

        const [startText, endTextWithSettings = ''] = timeLine.split('-->');
        const start = parseTimestamp(startText);
        const endText = endTextWithSettings.trim().split(/\s+/)[0];
        const cueLines = [];

        index += 1;

        while (index < lines.length && lines[index].trim()) {
          cueLines.push(lines[index]);
          index += 1;
        }

        const parsedCue = parseCueText(cueLines.join('\n'));

        segments.push({
          start,
          end: parseTimestamp(endText),
          speaker: parsedCue.speaker,
          text: parsedCue.text
        });
      }

      return segments.filter((segment) => segment.text.length > 0);
    };

    const clearTranscriptStatus = () => {
      transcript?.querySelector('[data-transcript-status]')?.remove();
    };

    const renderSegments = (segments) => {
      if (!transcript) {
        return;
      }

      transcript.innerHTML = '';

      if (segments.length === 0) {
        transcript.innerHTML = '<p class="transcript-status">No transcript available.</p>';
        return;
      }

      const fragment = document.createDocumentFragment();

      segments.forEach((segment, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'segment';
        button.dataset.segment = '';
        button.dataset.index = String(index);
        button.dataset.start = String(segment.start);

        if (typeof segment.end === 'number') {
          button.dataset.end = String(segment.end);
        }

        const time = document.createElement('span');
        time.className = 'time';
        time.textContent = formatTime(segment.start);

        const content = document.createElement('span');
        content.className = 'content';

        if (segment.speaker) {
          const speaker = document.createElement('span');
          speaker.className = 'speaker';
          speaker.textContent = segment.speaker;
          content.append(speaker);
        }

        const text = document.createElement('span');
        text.className = 'text';
        text.textContent = segment.text;

        content.append(text);
        button.append(time, content);
        fragment.append(button);
      });

      transcript.append(fragment);
    };

    const refreshActiveSegment = () => {
      const segments = getSegments();

      segments.forEach((segment, index) => {
        segment.classList.toggle('active', index === activeIndex);
      });
    };

    const updateActiveSegment = () => {
      if (!audio) {
        return;
      }

      const currentTime = audio.currentTime;
      const segments = getSegments();

      let newIndex = -1;

      segments.forEach((segment, index) => {
        const start = Number(segment.dataset.start || 0);
        const end = Number(segment.dataset.end || Number.MAX_SAFE_INTEGER);

        if (currentTime >= start && currentTime < end) {
          newIndex = index;
        }
      });

      if (newIndex === activeIndex) {
        return;
      }

      activeIndex = newIndex;

      refreshActiveSegment();

      if (autoFollow && activeIndex >= 0) {
        const activeSegment = segments[activeIndex];

        activeSegment.scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
      }
    };

    followButton?.addEventListener('click', () => {
      autoFollow = !autoFollow;

      followButton.textContent = autoFollow
        ? 'Auto Follow: On'
        : 'Auto Follow: Off';
    });

    transcript?.addEventListener('click', (event) => {
      const clickedSegment =
        event.target instanceof Element
          ? event.target.closest('[data-segment]')
          : null;

      if (!clickedSegment || !transcript.contains(clickedSegment) || !audio) {
        return;
      }

      const start = Number(clickedSegment.dataset.start || 0);

      audio.currentTime = start;
      audio.play();
    });

    audio?.addEventListener('timeupdate', updateActiveSegment);

    transcript?.addEventListener('wheel', () => {
      autoFollow = false;

      if (followButton) {
        followButton.textContent = 'Auto Follow: Off';
      }
    });

    if (transcriptSource) {
      fetch(transcriptSource)
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Failed to load transcript: ${response.status}`);
          }

          return response.text();
        })
        .then((text) => {
          clearTranscriptStatus();
          renderSegments(parseWebVtt(text));
          updateActiveSegment();
        })
        .catch(() => {
          renderSegments([]);
        });
    }
  }
</script>

<style>
  .audio-player {
    margin: 2rem 0;
    color: var(--sl-color-white);
  }

  .player-shell {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--accent) 20%, transparent), transparent 30%),
      linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    backdrop-filter: blur(18px);
    box-shadow:
      0 20px 60px rgba(0,0,0,0.35),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .player-top {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
  }

  .poster {
    width: 90px;
    height: 90px;
    object-fit: cover;
    border-radius: 1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .poster.placeholder {
    display: grid;
    place-items: center;
  }

  .poster svg {
    width: 2rem;
    height: 2rem;
    opacity: 0.7;
  }

  .meta {
    min-width: 0;
  }

  .eyebrow {
    margin-bottom: 0.35rem;
    color: color-mix(in srgb, var(--accent) 70%, white);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .meta h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .meta p {
    margin: 0.35rem 0 0;
    opacity: 0.7;
    font-size: 0.95rem;
  }

  .native-audio {
    width: calc(100% - 2.5rem);
    margin: 0 1.25rem 1.25rem;
    border-radius: 999px;
    accent-color: var(--accent);
  }

  .transcript-wrapper {
    border-top: 1px solid rgba(255,255,255,0.06);
    background: rgba(0,0,0,0.12);
  }

  .transcript-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .follow-button {
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 999px;
    background: rgba(255,255,255,0.03);
    color: inherit;
    cursor: pointer;
    transition: 160ms ease;
  }

  .follow-button:hover {
    background: rgba(255,255,255,0.08);
  }

  .transcript {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 360px;
    overflow: auto;
    padding: 0 1rem 1rem;
    scroll-behavior: smooth;
  }

  .transcript :global(.transcript-status) {
    margin: 0;
    padding: 0.5rem 0.25rem 0;
    color: rgba(255,255,255,0.72);
    font-size: 0.92rem;
  }

  .transcript :global(.segment) {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: rgba(255,255,255,0.03);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .transcript :global(.segment:hover) {
    transform: translateY(-1px);
    background: rgba(255,255,255,0.06);
  }

  .transcript :global(.segment.active) {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 14%, rgba(255,255,255,0.05));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .transcript :global(.segment .time) {
    flex-shrink: 0;
    min-width: 48px;
    color: color-mix(in srgb, var(--accent) 75%, white);
    font-family: monospace;
    font-size: 0.82rem;
    opacity: 0.9;
  }

  .transcript :global(.segment .content) {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .transcript :global(.segment .speaker) {
    align-self: flex-start;
    padding: 0.18rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, rgba(255,255,255,0.05));
    color: color-mix(in srgb, var(--accent) 72%, white);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .transcript :global(.segment .text) {
    line-height: 1.6;
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .player-top {
      align-items: flex-start;
    }

    .poster {
      width: 72px;
      height: 72px;
    }

    .transcript :global(.segment) {
      flex-direction: column;
      gap: 0.5rem;
    }

    .transcript :global(.segment .content) {
      width: 100%;
    }
  }
</style>